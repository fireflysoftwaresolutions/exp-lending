<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.fireflysoftware</groupId>
        <artifactId>exp-lending</artifactId>
        <version>26.10.6</version>
    </parent>

    <artifactId>exp-lending-core</artifactId>
    <name>exp-lending-core</name>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Internal modules -->
        <dependency>
            <groupId>io.fireflysoftware</groupId>
            <artifactId>exp-lending-infra</artifactId>
        </dependency>

        <!-- Domain SDKs (needed for model types in service implementations) -->
        <dependency>
            <groupId>io.fireflysoftware</groupId>
            <artifactId>domain-lending-loan-origination-sdk</artifactId>
        </dependency>
        <dependency>
            <groupId>io.fireflysoftware</groupId>
            <artifactId>domain-lending-loan-servicing-sdk</artifactId>
        </dependency>
        <dependency>
            <groupId>io.fireflysoftware</groupId>
            <artifactId>domain-lending-credit-scoring-sdk</artifactId>
        </dependency>
        <dependency>
            <groupId>io.fireflysoftware</groupId>
            <artifactId>domain-core-security-center-sdk</artifactId>
            <version>26.10.6</version>
        </dependency>
        <dependency>
            <groupId>io.fireflysoftware</groupId>
            <artifactId>domain-core-configuration-sdk</artifactId>
            <version>26.10.6</version>
        </dependency>
        <dependency>
            <groupId>io.fireflysoftware</groupId>
            <artifactId>domain-lending-asset-finance-sdk</artifactId>
        </dependency>
        <dependency>
            <groupId>io.fireflysoftware</groupId>
            <artifactId>domain-lending-delinquency-collections-sdk</artifactId>
        </dependency>
        <dependency>
            <groupId>io.fireflysoftware</groupId>
            <artifactId>domain-lending-personal-loans-sdk</artifactId>
        </dependency>
        <dependency>
            <groupId>io.fireflysoftware</groupId>
            <artifactId>domain-lending-mortgage-sdk</artifactId>
        </dependency>
        <dependency>
            <groupId>io.fireflysoftware</groupId>
            <artifactId>domain-lending-supply-chain-finance-sdk</artifactId>
        </dependency>
        <dependency>
            <groupId>io.fireflysoftware</groupId>
            <artifactId>domain-product-catalog-sdk</artifactId>
        </dependency>
        <dependency>
            <groupId>io.fireflysoftware</groupId>
            <artifactId>domain-product-pricing-sdk</artifactId>
        </dependency>
        <dependency>
            <groupId>io.fireflysoftware</groupId>
            <artifactId>domain-core-pricing-engine-sdk</artifactId>
        </dependency>
        <dependency>
            <groupId>io.fireflysoftware</groupId>
            <artifactId>domain-common-contracts-sdk</artifactId>
        </dependency>
        <dependency>
            <groupId>io.fireflysoftware</groupId>
            <artifactId>domain-common-sca-sdk</artifactId>
        </dependency>
        <dependency>
            <groupId>io.fireflysoftware</groupId>
            <artifactId>domain-common-notifications-sdk</artifactId>
        </dependency>
        <dependency>
            <groupId>io.fireflysoftware</groupId>
            <artifactId>domain-payments-sdk</artifactId>
        </dependency>

        <!-- Common Libraries -->
        <dependency>
            <groupId>org.fireflyframework</groupId>
            <artifactId>fireflyframework-utils</artifactId>
        </dependency>
        <dependency>
            <groupId>org.fireflyframework</groupId>
            <artifactId>fireflyframework-web</artifactId>
        </dependency>

        <!-- Spring WebFlux -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- Mapping -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>

        <!-- Utils -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.fireflyframework</groupId>
            <artifactId>fireflyframework-security-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.fireflyframework</groupId>
            <artifactId>fireflyframework-security-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-jose</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-client</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>${lombok-mapstruct-binding.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
